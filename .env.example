# ─────────────────────────────────────────────────────────────────────────────
# MC PREPS — environment configuration
# Copy to .env (local) or set in your hosting provider (e.g. Vercel → Settings →
# Environment Variables). Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, RDS, local …). REQUIRED.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mcpreps?schema=public"

# Public URL of the website, no trailing slash. Used for canonical URLs, the
# sitemap, social previews and links in emails. REQUIRED in production.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# Admin sessions. REQUIRED. Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Set to true when running behind a proxy/host other than Vercel.
AUTH_TRUST_HOST=true

# Search-engine indexing. Defaults: production deployments are indexable,
# previews/staging are not. Force with "true"/"false".
# ALLOW_INDEXING=false

# ── Email (order notifications) ─────────────────────────────────────────────
# "resend" (production), "console" (log emails in development) or "disabled".
EMAIL_TRANSPORT=resend
RESEND_API_KEY=""
# Sender on a domain verified in Resend, e.g. "MC PREPS <orders@yourdomain.com>"
EMAIL_FROM=""

# ── Image storage ───────────────────────────────────────────────────────────
# "local" stores uploads on disk (development / single server only).
# "s3" for production: AWS S3, Cloudflare R2, Backblaze B2, MinIO …
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
# S3-compatible settings (when STORAGE_DRIVER=s3)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false
# Public base URL that serves the bucket (CDN / R2 public bucket / CloudFront)
MEDIA_PUBLIC_BASE_URL=""

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Protects /api/cron/* (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=""

# ── Optional spam protection (Cloudflare Turnstile) ─────────────────────────
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Salt used to hash rate-limit keys (defaults to AUTH_SECRET).
HASH_SALT=""

# ── Development & testing only ──────────────────────────────────────────────
# Disposable database for integration tests (it is wiped on every run).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mcpreps_test?schema=public"
# Disposable database for Playwright end-to-end tests (name must contain "e2e").
E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mcpreps_e2e?schema=public"
# Optional: create the first owner account during `npm run db:seed`.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_NAME=""
